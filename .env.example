# ==========================================
# SIGVER - Variables de entorno
# ==========================================
# Copiar este archivo a ".env" y completar los valores reales.
# NUNCA subir el .env al repositorio.
# ==========================================

# ------------------------------------------
# Django
# ------------------------------------------
DJANGO_SECRET_KEY=cambiar-por-clave-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_SETTINGS_MODULE=config.settings.dev

# ------------------------------------------
# Base de datos (PostgreSQL + PostGIS)
# ------------------------------------------
DB_NAME=sigver_db
DB_USER=sigver_admin
DB_PASSWORD=cambiar-por-password-segura
DB_HOST=db
DB_PORT=5432

# ------------------------------------------
# CORS (desarrollo)
# ------------------------------------------
CORS_ALLOW_ALL_ORIGINS=True

# ------------------------------------------
# Frontend / PWA
# ------------------------------------------
VITE_API_BASE_URL=/api/
