# ==========================================
# SIGVER - Variables de entorno
# ==========================================
# Copiar este archivo a ".env" y completar los valores reales.
# NUNCA subir el .env al repositorio.
# ==========================================

# ------------------------------------------
# Django
# ------------------------------------------
DJANGO_SECRET_KEY=cambiar-por-clave-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_SETTINGS_MODULE=config.settings.dev

# ------------------------------------------
# Base de datos (PostgreSQL + PostGIS)
# ------------------------------------------
DB_NAME=sigver_db
DB_USER=sigver_admin
DB_PASSWORD=cambiar-por-password-segura
DB_HOST=db
DB_PORT=5432

# ------------------------------------------
# CSRF / CORS
# ------------------------------------------
# Orígenes desde los que se usa el admin (separados por coma)
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://localhost:8000,http://127.0.0.1:8000
# Solo en producción (en desarrollo se permiten todos)
DJANGO_CORS_ALLOWED_ORIGINS=

# ------------------------------------------
# Pruebas por internet (scripts/ngrok.sh)
# ------------------------------------------
# Dominio fijo gratis de ngrok (dashboard.ngrok.com > Domains)
NGROK_DOMAIN=abridge-niece-bling.ngrok-free.dev

# ------------------------------------------
# Frontend / PWA
# ------------------------------------------
VITE_API_BASE_URL=/api/
